{
  "name": "mars-ts",
  "private": true,
  "version": "1.0.0-dev.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint src vite.config.ts eslint.config.js prettier.config.js playwright.config.ts \"tests/**/*.ts\" \"tests/browser/**/*.mjs\"",
    "format": "prettier --write src package.json vite.config.ts tsconfig.json eslint.config.js prettier.config.js playwright.config.ts tests/browser \"tests/**/*.ts\" \"tests/**/*.mjs\"",
    "test:unit": "vitest",
    "test": "vitest run",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check src package.json vite.config.ts tsconfig.json eslint.config.js prettier.config.js playwright.config.ts tests/browser \"tests/**/*.ts\" \"tests/**/*.mjs\"",
    "test:browser": "node tests/browser/harness/run.mjs",
    "test:browser:install": "playwright install --with-deps chromium",
    "build:standalone": "node standalone/scripts/build.mjs",
    "check:standalone": "node --test standalone/scripts/build.test.mjs && node standalone/scripts/check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/mcp": "0.1.30",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26 <27"
  }
}
