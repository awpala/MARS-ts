{
	"name": "mars-ts",
	"private": true,
	"version": "1.0.0-dev.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint src vite.config.ts eslint.config.js prettier.config.js playwright.config.ts \"tests/**/*.ts\"",
		"format": "prettier --write src package.json vite.config.ts tsconfig.json eslint.config.js prettier.config.js playwright.config.ts tests/browser \"tests/**/*.ts\"",
		"test:unit": "vitest",
		"test": "vitest run",
		"lint:fix": "npm run lint -- --fix",
		"format:check": "prettier --check src package.json vite.config.ts tsconfig.json eslint.config.js prettier.config.js playwright.config.ts tests/browser \"tests/**/*.ts\"",
		"test:browser": "playwright test",
		"test:browser:install": "playwright install --with-deps chromium"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/mcp": "0.1.27",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"license": "MIT",
	"engines": {
		"node": ">=24 <25"
	}
}
