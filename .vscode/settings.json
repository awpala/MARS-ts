{
  // Keep the read-only Java oracle browsable without reporting its diagnostics.
  // Red Hat Java requires Reload Window after this filter changes.
  "java.diagnostic.filter": ["**/_legacy-app/**"],
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".vscode",
    ".vscode-insiders",
    "**/_legacy-app/**",
  ],
  "cSpell.words": [
    "awpala",
    "backstep",
    "backstepping",
    "backsteps",
    "bkpt",
    "coproc",
    "coprocs",
    "Coolify",
    "healthcheck",
    "healthz",
    "hoverable",
    "inspectable",
    "keycap",
    "keycaps",
    "llms",
    "mmio",
    "Nixpack",
    "Nixpacks",
    "noninteractive",
    "precache",
    "precached",
    "precaches",
    "precaching",
    "prerender",
    "prerendered",
    "prerendering",
    "prerenders",
    "Sanderson",
    "spim",
    "SPIM",
    "syscall",
    "syscalls",
    "Vollmar",
  ],
}
