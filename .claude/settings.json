      "Edit(/_legacy-app/mainclass.txt)",
      "Edit(/_legacy-app/help/**)",
      "Edit(/_legacy-app/images/**)",
      "Edit(/_legacy-app/docs/*.html)",
      "Edit(/_legacy-app/docs/package-list)",
      "Edit(/_legacy-app/docs/stylesheet.css)",
      "Edit(/_legacy-app/docs/mars/**)",
      "Edit(/_legacy-app/docs/resources/**)",
      "Edit(/_legacy-app/META-INF/**)"
