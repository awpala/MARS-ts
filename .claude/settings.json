{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(run-checks)",
      "Bash(run-checks *)",
      "Bash(bash .devcontainer/scripts/bin/checks.sh)",
      "Bash(bash .devcontainer/scripts/bin/checks.sh *)",
      "Bash(tests)",
      "Bash(build-legacy)",
      "Bash(run-legacy *)",
      "Bash(java -version)",
      "Bash(javac -version)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm --prefix /workspace run *)",
      "Bash(npm --prefix /workspace ci)",
      "Bash(node *)",
      "Bash(sv --version)",
      "Bash(curl *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find . -type *)",
      "Bash(sed -i 's#save/import/export \\(both assembly extensions\\)/delete/rename decisions#save/import \\(both assembly extensions and ZIP archives, with skipped-item summaries\\)/export \\(with the blocking transfer status\\)/delete/rename decisions#' IMPLEMENTATION.md)"
    ],
    "deny": [
