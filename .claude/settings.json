      "Edit(/images/**)",
      "Edit(/docs-legacy/*.html)",
      "Edit(/docs-legacy/package-list)",
      "Edit(/docs-legacy/stylesheet.css)",
      "Edit(/docs-legacy/mars/**)",
      "Edit(/docs-legacy/resources/**)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npx *)",
      "Bash(sv create *)",
      "Bash(sv add *)",
      "Bash(sv migrate *)",
      "Bash(docker *)"
    ]
